.env
.venv/
__pycache__/
.pytest_cache/
.coverage
htmlcov/
*.py[cod]
data/raw/*
data/derived/*
data/gold/*
!data/raw/.gitkeep
!data/derived/.gitkeep
!data/gold/.gitkeep
artifacts/*
!artifacts/.gitkeep
results/traces/*
!results/traces/.gitkeep
*.faiss
*.index
.DS_Store

# Python packaging/build output (created by `pip install -e .`)
*.egg-info/
build/
dist/

# Tool caches
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Course-provided TLS certificates (distributed by the coordinator; keep out of the public repo)
config/*.crt
*.crt

# Any env/secrets variant except the documented template
.env.*
!.env.example

# Keys and credentials in any other form
*.pem
*.key
*.p12
*api-key*.txt
*-key.txt
secrets/
