# Qwen endpoint must be OpenAI Chat Completions compatible.
QWEN_API_BASE=https://YOUR-QWEN-ENDPOINT/v1
QWEN_API_KEY=REPLACE_ME
QWEN_MODEL=Qwen/Qwen3-8B
# Private CA for the Qwen endpoint (place it in config/, git-ignored) and request timeout
QWEN_CA_CERT=config/qwen-ca.crt
QWEN_TIMEOUT_SECONDS=45

# Shared embedding API (BGE-small-en-v1.5, 384-dim). Key comes from the coordinator; never commit it.
# EMBEDDING_PROVIDER: auto (API when base+key set, else local model) | api | local
EMBEDDING_PROVIDER=auto
EMBEDDING_API_BASE=https://YOUR-EMBEDDING-HOST:PORT/v1
EMBEDDING_API_KEY=REPLACE_ME
EMBEDDING_MODEL=bge-small-en-v1.5
# Private CA that signed the embedding server certificate. Place vm02-ca.crt in config/ (git-ignored);
# relative paths resolve from the project root, ~ is expanded.
EMBEDDING_CA_CERT=config/vm02-ca.crt

# Local paths and resource guardrails
VERISHEET_DATA_DIR=data
VERISHEET_ARTIFACT_DIR=artifacts
VERISHEET_TRACE_DIR=results/traces
MAX_UPLOAD_MB=50
MAX_SAMPLE_ROWS=50
MAX_AGENT_ACTIONS=10
MAX_REPAIRS=2
EXECUTION_TIMEOUT_SECONDS=20
EXECUTION_MEMORY_MB=1024
LOG_LEVEL=INFO
